# Backend
ENV=development
DATABASE_URL=postgresql+asyncpg://pcb_user:pcb_password@db:5432/pcb_defects
MODEL_PATH=app/ml/best.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
INFERENCE_IMG_SIZE=640
DEVICE=cpu
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production uchun qo'shimcha (docker-compose.prod.yml bilan ishlatiladi)
POSTGRES_USER=pcb_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=pcb_defects
BACKEND_IMAGE=ghcr.io/your-org/pcb-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/pcb-frontend:latest
